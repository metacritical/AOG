#!/usr/bin/env bash
set -euo pipefail

AOG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
EMACS_BIN="${EMACS_BIN:-emacs}"
DEFAULT_THEME="${AOG_THEME:-selfdotsend}"

usage() {
  cat <<USAGE
Usage:
  aog create <site_name> [target_dir]        Create a new blog scaffold
  aog publish [repo_dir] [output_dir]        Publish site to output directory
  aog preview [repo_dir] [output_dir] [port] Publish and preview locally
  aog new [repo_dir] [--publish] "Title"      Create new draft/post
  aog ls [repo_dir]                            List drafts
USAGE
}

slugify() {
  local s
  s="$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')"
  s="$(printf '%s' "$s" | sed -E 's/[^a-z0-9]+/-/g; s/-+/-/g; s/^-|-$//g')"
  if [ -z "$s" ]; then
    s="site-$(date +%Y%m%d-%H%M%S)"
  fi
  printf '%s\n' "$s"
}

resolve_repo() {
  local in="${1:-$PWD}"
  if [ -d "$in" ]; then
    (cd "$in" && pwd)
  else
    echo "$PWD"
  fi
}

run_publish() {
  local repo_dir="$1"
  local out_dir="$2"
  local include_drafts="${3:-0}"
  local tmp_el
  tmp_el="$(mktemp -t aog-run.XXXXXX.el)"
  trap 'rm -f "${tmp_el:-}"' EXIT

  cat > "$tmp_el" <<ELISP
(let* ((build-root (expand-file-name "~/.config/emacs/.local/straight/build-30.2")))
  (when (file-directory-p build-root)
    (dolist (d (directory-files build-root t "^[^.].*"))
      (when (file-directory-p d)
        (add-to-list 'load-path d)))))
(add-to-list 'load-path "$AOG_DIR")
(require 'htmlize nil t)
(require 'aog)
(setq aog/repository-directory "$repo_dir")
(when (file-exists-p (expand-file-name "aog-site.el" "$repo_dir"))
  (load (expand-file-name "aog-site.el" "$repo_dir") nil t))
(setq aog/theme (or (and (boundp 'aog/theme) aog/theme) '$DEFAULT_THEME))
(setq aog/site-domain (or (and (boundp 'aog/site-domain) aog/site-domain) "https://example.com"))
(setq aog/site-main-title (or (and (boundp 'aog/site-main-title) aog/site-main-title) "My AOG Blog"))
(setq aog/site-sub-title (or (and (boundp 'aog/site-sub-title) aog/site-sub-title) "Built with AOG"))
(setq aog/personal-github-link (or (and (boundp 'aog/personal-github-link) aog/personal-github-link) "https://github.com"))
(setq aog/highlight-render 'htmlize)
(setq aog/category-ignore-list
      (append '("themes" "assets" "public" "tags")
              (if (string= "$include_drafts" "1") '() '("drafts"))))
(setq org-src-fontify-natively t)
(setq org-html-htmlize-output-type 'css)
(aog/do-publication t nil "$out_dir" nil nil)
ELISP

  "$EMACS_BIN" --batch -l "$tmp_el"
}

write_template_script() {
  local file="$1"
  local mode="$2"
  if [ "$mode" = "new-article" ]; then
    cat > "$file" <<'T'
#!/usr/bin/env bash
set -euo pipefail
mode="drafts"
if [ "__DOLLAR__{1:-}" = "--publish" ]; then
  mode="posts"
  shift
fi
title="__DOLLAR__{1:-Untitled}"
slug="__DOLLAR__(echo "__DOLLAR__title" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-|-$//g')"
[ -n "__DOLLAR__slug" ] || slug="untitled-__DOLLAR__(date +%H%M%S)"
out="__DOLLAR__mode/__DOLLAR__slug.org"
if [ -e "__DOLLAR__out" ]; then out="__DOLLAR__mode/__DOLLAR__slug-__DOLLAR__(date +%H%M%S).org"; fi
cat > "__DOLLAR__out" <<DOC
#+TITLE: __DOLLAR__title
#+DATE: __DOLLAR__(date +%Y-%m-%d)
#+OPTIONS: toc:nil
#+DESCRIPTION: Draft post

Write your post here.
DOC
echo "__DOLLAR__out"
T
  else
    cat > "$file" <<'T'
#!/usr/bin/env bash
set -euo pipefail
repo_dir="__DOLLAR__(cd "__DOLLAR__(dirname "__DOLLAR__0")" && pwd)"
out_dir="__DOLLAR__repo_dir/public"
aog publish "__DOLLAR__repo_dir" "__DOLLAR__out_dir"
T
  fi
  perl -i -pe 's/__DOLLAR__/\$/g' "$file"
  chmod +x "$file"
}

create_site() {
  local name="$1"
  local target_root="${2:-$PWD}"
  local slug dir today
  slug="$(slugify "$name")"
  dir="$target_root/$slug"
  today="$(date +%Y-%m-%d)"

  if [ -e "$dir" ]; then
    echo "Target exists: $dir" >&2
    exit 1
  fi

  mkdir -p "$dir"/{posts,drafts,assets,media/css,media/js,media/images,tags,scripts}

  cat > "$dir/aog-site.el" <<SITE_EL
(setq aog/site-domain "https://example.com"
      aog/site-main-title "$name"
      aog/site-sub-title "Built with AOG"
      aog/personal-github-link "https://github.com/your-user"
      aog/theme '$DEFAULT_THEME
      aog/personal-disqus-shortname nil)
SITE_EL

  cat > "$dir/index.org" <<INDEX_ORG
#+TITLE: Home
#+URI: /
#+OPTIONS: toc:nil

* Welcome

This site was created with =aog create=.
INDEX_ORG

  cat > "$dir/about.org" <<ABOUT_ORG
#+TITLE: About
#+URI: /about/
#+OPTIONS: toc:nil

* About

Write about yourself and this blog.
ABOUT_ORG

  cat > "$dir/posts/first-post.org" <<POST_ORG
#+TITLE: First Post
#+DATE: $today
#+URI: /blog/%y/%m/%d/first-post
#+KEYWORDS: aog, org-mode
#+TAGS: blog
#+OPTIONS: toc:nil
#+DESCRIPTION: First post generated by AOG scaffold.

Hello from your new AOG site.
POST_ORG

  write_template_script "$dir/scripts/new-article.sh" "new-article"
  write_template_script "$dir/publish.sh" "publish"

  cat > "$dir/README.md" <<README_MD
# $name

Generated by AOG scaffold.

## Quick start

\`\`\`bash
cd "$slug"
./publish.sh
python -m http.server 8080 -d public
\`\`\`

Then open http://localhost:8080
README_MD

  echo "Created: $dir"
  echo "Next: cd $dir && ./publish.sh"
}

cmd="${1:-}"
case "$cmd" in
  create)
    shift
    name="${1:-}"
    [ -n "$name" ] || { echo "Missing site name" >&2; usage; exit 1; }
    shift || true
    create_site "$name" "${1:-$PWD}"
    ;;
  publish)
    shift || true
    repo="$(resolve_repo "${1:-$PWD}")"
    out="${2:-$repo/public}"
    run_publish "$repo" "$out" "${AOG_INCLUDE_DRAFTS:-0}"
    ;;
  preview)
    shift || true
    repo="$(resolve_repo "${1:-$PWD}")"
    out="${2:-$repo/public}"
    port="${3:-8080}"
    run_publish "$repo" "$out" "${AOG_INCLUDE_DRAFTS:-0}"
    python -m http.server "$port" -d "$out"
    ;;
  new)
    shift || true
    repo="$(resolve_repo "$PWD")"
    publish_flag=""
    if [ "${1:-}" = "--publish" ]; then publish_flag="--publish"; shift; fi
    if [ -d "${1:-}" ] && [ -f "${1:-}/scripts/new-article.sh" ]; then repo="$(resolve_repo "$1")"; shift; fi
    title="${1:-Untitled}"
    (cd "$repo" && ./scripts/new-article.sh ${publish_flag:+$publish_flag} "$title")
    ;;
  ls)
    shift || true
    repo="$(resolve_repo "${1:-$PWD}")"
    if [ ! -d "$repo/drafts" ]; then echo "No drafts directory"; exit 0; fi
    find "$repo/drafts" -maxdepth 1 -type f -name "*.org" -print | sed "s#^$repo/##" | sort
    ;;
  ""|-h|--help|help)
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage
    exit 1
    ;;
esac
